{
  "name": "cloud-security-list",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "yarn generate-icons && next build",
    "dev": "NODE_OPTIONS='--inspect' next dev",
    "lint": "next lint",
    "typecheck": "tsc --noEmit --incremental false",
    "format": "prettier -w .",
    "format:check": "prettier -c .",
    "start": "next start",
    "typegen": "sanity schema extract --enforce-required-fields && sanity typegen generate && prettier -w src/lib/sanity/types.ts",
    "generate-icons": "dotenv -c -- node scripts/generate-icons.js && prettier -w src/components/common/Icon/mapping.ts"
  },
  "dependencies": {
    "@headlessui/react": "2.2.0",
    "@portabletext/react": "3.1.0",
    "@sanity/asset-utils": "2.2.1",
    "@sanity/icons": "3.4.0",
    "@sanity/image-url": "1.1.0",
    "@sanity/vision": "3.65.0",
    "clsx": "2.1.1",
    "next": "15.1.2",
    "next-sanity": "9.8.16",
    "parse-github-url": "1.0.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-icons": "5.3.0",
    "react-infinite-scroll-hook": "5.0.1",
    "sanity": "3.65.0",
    "server-only": "0.0.1",
    "speakingurl": "14.0.1",
    "styled-components": "6.1.13"
  },
  "devDependencies": {
    "@portabletext/types": "2.0.13",
    "@svgr/webpack": "8.1.0",
    "@tailwindcss/forms": "0.5.9",
    "@types/node": "22.10.0",
    "@types/parse-github-url": "1.0.3",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@typescript-eslint/eslint-plugin": "8.16.0",
    "@typescript-eslint/parser": "8.16.0",
    "dotenv-cli": "7.4.4",
    "eslint": "9.15.0",
    "eslint-config-next": "15.0.3",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-no-relative-import-paths": "1.5.5",
    "lint-staged": "15.2.10",
    "postcss": "8.4.49",
    "prettier": "3.4.1",
    "prettier-plugin-organize-imports": "4.1.0",
    "prettier-plugin-tailwindcss": "0.6.9",
    "schema-dts": "1.1.2",
    "tailwindcss": "3.4.15",
    "typescript": "5.7.2"
  },
  "packageManager": "yarn@1.22.22+sha1.ac34549e6aa8e7ead463a7407e1c7390f61a6610"
}
